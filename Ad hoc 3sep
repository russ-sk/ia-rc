# %% A9. Threshold-driven scorecard -------------------------------------------
def _sets(df, rid, col):
    if col not in df.columns: return set()
    s = df.loc[df.RECORD_ID.astype(str).str.strip()==str(rid), col]
    return {x for x in s.dropna().astype(str).str.strip() if x.lower() not in PLACEHOLDER}

ALL_GOLD = sorted(set(gold.RECORD_ID))

def scorecard_at(threshold, decisions={"LINKED"}, show=True):
    acc = verdicts[verdicts.decision.isin(decisions) & (verdicts.ctrl_score >= threshold)]
    p   = acc.merge(c2lc, on="L1_CTRL", how="left")
    pred = {"L1 Control":       (p[["RECORD_ID","L1_CTRL"]], "L1_CTRL"),
            "L1 Library Control":(p.dropna(subset=["L1_LIB_CTRL"])[["RECORD_ID","L1_LIB_CTRL"]], "L1_LIB_CTRL")}
    rows=[]
    for level,(pdf,pcol) in pred.items():
        pdf=pdf.copy(); pdf["RECORD_ID"]=pdf.RECORD_ID.astype(str).str.strip()
        gcol = "L1_CTRL" if level=="L1 Control" else "L1_LIB_CTRL"
        gp={(r,x) for r in ALL_GOLD for x in _sets(gold,r,gcol)}
        pp={(r,x) for r in set(pdf.RECORD_ID) for x in _sets(pdf,r,pcol)}
        val,miss,new=len(gp&pp),len(gp-pp),len(pp-gp)
        rg={r for r,_ in gp}; rh={r for r,_ in (gp&pp)}
        per=pdf.groupby("RECORD_ID")[pcol].nunique()
        rows.append({"threshold":threshold,"decisions":"+".join(sorted(decisions)),
                     "level":level,"Golden":len(gp),"Validated":val,"Missed":miss,
                     "Recall":round(val/len(gp),3) if gp else np.nan,
                     "New/Review":new,"Coverage":f"{len(rh)}/{len(rg)}",
                     "median/alert":int(per.median()) if len(per) else 0,
                     "max/alert":int(per.max()) if len(per) else 0})
    card=pd.DataFrame(rows)
    if show:
        print(f"\n=== scorecard @ threshold {threshold}  decisions={sorted(decisions)} ===")
        print(card.drop(columns=["decisions"]).to_string(index=False))
    return card

