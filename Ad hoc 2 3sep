from collections import Counter
def scorecard_at(threshold, show=True):
    acc = verdicts[verdicts.ctrl_score >= threshold].copy()
    acc["RECORD_ID"] = acc.RECORD_ID.astype(str).str.strip()
    # keep only predictions in the Detailed universe
    acc = acc[[ (r,c) in DETAILED_CAND
                for r,c in zip(acc.RECORD_ID, acc.L1_CTRL.astype(str).str.strip()) ]]
    p = acc.merge(c2lc, on="L1_CTRL", how="left")
    p1c  = {(r,c) for r,c in p[["RECORD_ID","L1_CTRL"]].itertuples(index=False,name=None)
            if str(c).lower() not in PLACEHOLDER}
    pl1c = {(r,c) for r,c in p.dropna(subset=["L1_LIB_CTRL"])[["RECORD_ID","L1_LIB_CTRL"]]
                    .itertuples(index=False,name=None) if str(c).lower() not in PLACEHOLDER}
    rows=[]
    for level, pp, gtot in [("L1 Control", p1c, GTOT_1C),
                            ("L1 Library Control", pl1c, GTOT_L1C)]:
        val,miss,new = len(gtot&pp), len(gtot-pp), len(pp-gtot)
        rg={r for r,_ in gtot}; rh={r for r,_ in (gtot&pp)}
        per=Counter(r for r,_ in pp)
        rows.append({"threshold":threshold,"level":level,"Golden":len(gtot),
                     "Validated":val,"Missed":miss,
                     "Recall":round(val/len(gtot),3) if gtot else np.nan,
                     "New/Review":new,"Coverage":f"{len(rh)}/{len(rg)}",
                     "median/alert":int(np.median(list(per.values()))) if per else 0,
                     "max/alert":max(per.values()) if per else 0})
    card=pd.DataFrame(rows)
    if show:
        print(f"\n=== scorecard @ threshold {threshold} (Detailed only) ===")
        print(card.to_string(index=False))
    return card

THRESHOLD = 0
scorecard_at(THRESHOLD)

