# %% A7c. Clean placeholders + re-rank (this is the cell that adds `corroborated`)
BAD_IDS = {"-", "nan", "None", ""}
sum_risks = sum_risks[~sum_risks.LIB_RISK_ID.astype(str).str.strip().isin(BAD_IDS)]
sum_risks = sum_risks[sum_risks.LIB_RISK_ID.astype(str).str.startswith("LR-")]
print(f"sum_risks after removing placeholders: {len(sum_risks):,} rows, "
      f"{sum_risks.LIB_RISK_ID.nunique()} distinct library risks")

laneA_risk = a_sum.merge(sum_risks, on=["REG_ID", "SUM_ID"], how="inner")

risk_rec = (laneA_risk
    .groupby(["RECORD_ID", "LIB_RISK_ID"])
    .agg(n_regulations   = ("REG_ID", "nunique"),
         n_summaries     = ("SUM_ID", "nunique"),
         max_link_score  = ("link_score", "max"),
         via_regulations = ("REG_ID", joinset),
         via_summaries   = ("SUM_ID", joinset),
         steward_areas   = ("SUM_STEWARD", joinset))
    .reset_index()
    .sort_values(["RECORD_ID", "n_regulations", "n_summaries", "max_link_score"],
                 ascending=[True, False, False, False]))

risk_rec["rank"]         = risk_rec.groupby("RECORD_ID").cumcount() + 1
risk_rec["corroborated"] = risk_rec.n_regulations > 1
risk_rec["source"]       = "regmap"

print(f"\nrows: {len(risk_rec)}   columns: {list(risk_rec.columns)}")
print(f"corroborated by >1 linked regulation: {risk_rec.corroborated.sum()} of {len(risk_rec)}")
print(risk_rec.groupby("RECORD_ID").corroborated.sum().to_string())
