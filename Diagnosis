# %% STAGE-1 DIAG 2
rows = []
for rid in no_link:
    greg = gold_reg.get(rid, set())
    seen = pc[pc.RECORD_ID == rid]
    seen_regs = set(seen.REG_ID)
    if not greg:
        cls = "A. no golden regulation (unscorable)"
    elif rid not in set(pc.RECORD_ID):
        cls = "B. record never processed by stage 1"
    elif greg & seen_regs:
        # golden reg WAS a candidate — so the judge saw it and didn't link it
        dec = seen.loc[seen.REG_ID.isin(greg), "decision"].value_counts().to_dict()
        cls = f"C. judge miss (saw golden reg, said {dec})"
    else:
        cls = "D. retrieval miss (golden reg never shortlisted)"
    rows.append({"RECORD_ID": rid, "n_golden_regs": len(greg),
                 "n_candidates": seen.REG_ID.nunique(), "class": cls})
s1 = pd.DataFrame(rows)
print(s1["class"].apply(lambda x: x.split("(")[0].strip()).value_counts().to_string())
print()
