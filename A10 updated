import ast, re

GOLDEN_RC_PATH = "../data/golden_risk_control.parquet"   # <-- adjust
G_RECORD, G_REG, G_DICT = "Record ID", "Regulation ID", "Risk_Control_dict"

# A risk key whose value is None: treat as "risk applies, no controls mapped".
# Set False if A11b shows the key sets are identical across records (= enumeration).
GOLDEN_NONE_RISK_IS_POSITIVE = True

BAD = {"-", "", "nan", "none", "null", "<na>"}

def _id(x):
    if x is None: return None
    s = str(x).strip()
    return None if s.lower() in BAD else s

def parse_rc(v):
    if isinstance(v, dict): return v
    if v is None or (isinstance(v, float) and pd.isna(v)): return {}
    s = re.sub(r"array\(\s*(\[.*?\])\s*(?:,\s*dtype=[^)]*)?\)", r"\1", str(v), flags=re.S)
    s = s.replace("nan", "None")
    try:
        d = ast.literal_eval(s)
        return d if isinstance(d, dict) else {}
    except Exception:
        return {}

def flatten_rc(d):
    rows = []
    for risk, ctrls in (d or {}).items():
        r = _id(risk)
        if r is None: continue
        if not isinstance(ctrls, dict) or not ctrls:
            if GOLDEN_NONE_RISK_IS_POSITIVE:
                rows.append((r, None, None))
            continue
        for ctrl, insts in ctrls.items():
            c = _id(ctrl)
            if c is None:
                if GOLDEN_NONE_RISK_IS_POSITIVE: rows.append((r, None, None))
                continue
            seq = [] if insts is None else (
                list(insts) if hasattr(insts, "__iter__") and not isinstance(insts, str)
                else [insts])
            seq = [i for i in (_id(x) for x in seq) if i is not None]
            rows += [(r, c, i) for i in seq] if seq else [(r, c, None)]
    return rows

gc_raw = pd.read_parquet(GOLDEN_RC_PATH)
gc_raw[G_RECORD] = gc_raw[G_RECORD].astype(str).str.strip()

grows = []
for _, row in gc_raw.iterrows():
    for r, c, i in flatten_rc(parse_rc(row[G_DICT])):
        grows.append({"RECORD_ID": row[G_RECORD], "REG_ID": _id(row.get(G_REG)),
                      "LIB_RISK_ID": r, "L1_LIB_CTRL": c, "L1_CTRL": i})
gold = pd.DataFrame(grows).drop_duplicates()

print(f"golden rows in file : {len(gc_raw):,}")
print(f"golden records      : {gold.RECORD_ID.nunique():,}")
print(f"flattened triples   : {len(gold):,}")
print(f"  library risks     : {gold.LIB_RISK_ID.nunique():,}")
print(f"  library controls  : {gold.L1_LIB_CTRL.nunique():,}")
print(f"  risks with no ctrl: {gold.loc[gold.L1_LIB_CTRL.isna(),'LIB_RISK_ID'].nunique():,}")

# %% A11b. Enumeration check — decides GOLDEN_NONE_RISK_IS_POSITIVE
keysets, rows = {}, []
for _, r in gc_raw.iterrows():
    d = parse_rc(r[G_DICT])
    risks  = {_id(k) for k in d} - {None}
    mapped = {_id(k) for k, v in d.items() if isinstance(v, dict) and v} - {None}
    rid = str(r[G_RECORD]).strip()
    keysets.setdefault(rid, set()).update(risks)
    rows.append({"RECORD_ID": rid, "risk_keys": len(risks),
                 "risks_mapped": len(mapped), "risks_None": len(risks - mapped)})

print(pd.DataFrame(rows).groupby("RECORD_ID")
      [["risk_keys","risks_mapped","risks_None"]].max().to_string())

ks = list(keysets.values())
n_distinct = len({frozenset(s) for s in ks})
print(f"\ndistinct risk-key sets across records : {n_distinct}")
print(f"intersection across all records       : {len(set.intersection(*ks))}")
print(f"union across all records              : {len(set.union(*ks))}")
print("\n-> 1 distinct set means pure enumeration; set "
      "GOLDEN_NONE_RISK_IS_POSITIVE = False in A11a and re-run it.")


# %% A11c. Lane A vs golden — flat set comparison
RECORDS = sorted({str(r) for r in KEEP_RECORDS} & set(gold.RECORD_ID))
print(f"scoring {len(RECORDS)} records: {RECORDS}")
absent = {str(r) for r in KEEP_RECORDS} - set(gold.RECORD_ID)
if absent: print(f"[!] not in golden, unscorable: {sorted(absent)}")

pred = laneA_exploded.copy()
pred["RECORD_ID"] = pred.RECORD_ID.astype(str).str.strip()

def sets_for(df, record, col):
    s = df.loc[df.RECORD_ID.astype(str).str.strip() == record, col]
    return set(s.dropna().astype(str).str.strip()) - BAD

def score(p, g):
    tp, fp, fn = len(p & g), len(p - g), len(g - p)
    pr = tp/(tp+fp) if (tp+fp) else np.nan
    rc_ = tp/(tp+fn) if (tp+fn) else np.nan
    f1 = 2*pr*rc_/(pr+rc_) if (pr and rc_ and pr+rc_) else np.nan
    return tp, fp, fn, pr, rc_, f1

rows = []
for level, col in [("library_risk", "LIB_RISK_ID"), ("l1_library_control", "L1_LIB_CTRL")]:
    all_p, all_g = set(), set()
    for rid in RECORDS:
        g, p = sets_for(gold, rid, col), sets_for(pred, rid, col)
        all_g |= {(rid, x) for x in g}; all_p |= {(rid, x) for x in p}
        tp, fp, fn, pr, rc_, f1 = score(p, g)
        rows.append({"RECORD_ID": rid, "level": level, "n_gold": len(g), "n_laneA": len(p),
                     "matched": tp, "extra_fp": fp, "missed_fn": fn,
                     "precision": pr, "recall": rc_, "f1": f1})
    tp, fp, fn, pr, rc_, f1 = score(all_p, all_g)
    rows.append({"RECORD_ID": "ALL", "level": level, "n_gold": len(all_g),
                 "n_laneA": len(all_p), "matched": tp, "extra_fp": fp, "missed_fn": fn,
                 "precision": pr, "recall": rc_, "f1": f1})

res = pd.DataFrame(rows)
print("\n" + res.to_string(index=False, float_format=lambda x: f"{x:.3f}"))
res.to_csv(OUTP / "laneA_eval_flat.csv", index=False)


