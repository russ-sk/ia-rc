# ------------------------------------------------------------------
# DEDUCTION RUBRIC (internal only - never shown to stakeholders)
# Every match starts at 100; each gap found costs these points.
# ------------------------------------------------------------------
RUBRIC = {
    "ACTOR_DIFFERENT":       15,
    "ACTION_PARTIAL":        20,
    "SCOPE_DIFFERENT":       10,
    "CONDITION_MISSING":     10,
    "TIMING_MISSING":        10,
    "THRESHOLD_MISSING":     10,
    "EXCEPTION_MISSING":      5,
    "DETAIL_MISSING":         5,
    "CITATION_SECTION_DIFF": 10,
    "CITATION_CLAUSE_DIFF":   5,
    "EXTRA_IN_REGMAP":        3,
}

# Plain-English meaning of each code (the model sees meanings, not point values)
RUBRIC_MEANING = {
    "ACTOR_DIFFERENT":       "the obligated party differs (e.g. card issuer vs creditor)",
    "ACTION_PARTIAL":        "the core required or prohibited action is only partly covered",
    "SCOPE_DIFFERENT":       "the product or account scope differs (e.g. open-end vs closed-end)",
    "CONDITION_MISSING":     "a trigger or condition is absent",
    "TIMING_MISSING":        "a deadline or timing requirement is absent or different",
    "THRESHOLD_MISSING":     "a numeric amount or limit is absent or different",
    "EXCEPTION_MISSING":     "an exception or exemption is absent",
    "DETAIL_MISSING":        "a smaller element (form, method, content item) is absent",
    "CITATION_SECTION_DIFF": "the citation points to a different section",
    "CITATION_CLAUSE_DIFF":  "same section but a different or parent-level clause",
    "EXTRA_IN_REGMAP":       "RegMap contains a requirement not present in the vendor text",
}
rubric_text = "\n".join(f"  {k}: {RUBRIC_MEANING[k]}" for k in RUBRIC)


def build_prompt(v):
    """v = one vendor row. Returns the full prompt. {{ }} become { } in the f-string."""
    return f"""You are a senior US regulatory compliance analyst reviewing Regulation Z (Truth in Lending, 12 CFR 1026).
Your written output will be read by senior compliance and risk stakeholders.

TASK
Compare ONE vendor-identified obligation against HSBC's internal RegMap obligations.
Identify every RegMap obligation that addresses the SAME core requirement and describe the differences.

STEP A - IDENTIFY MATCHES
Only list a RegMap obligation if it addresses the same core requirement
(same subject matter AND the same kind of duty or prohibition).
Judge mainly on the meaning of the text. Use citations as supporting evidence only:
a matching citation alone is not sufficient, and a different citation does not rule a match out.

STEP B - BREAK DOWN THE VENDOR OBLIGATION
List its elements: obligated party, required/prohibited action, scope (products/accounts),
conditions or triggers, timing, numeric thresholds, exceptions, other material details.

STEP C - RECORD GAPS PER MATCH (internal use only)
For each vendor element a RegMap obligation does not cover, or covers differently, record ONE gap
using one of these codes. Also record requirements present in RegMap but absent from the vendor text.
{rubric_text}
Each gap must include short quoted evidence. Record each distinct gap once only.
If a RegMap obligation fully covers the vendor obligation, its gaps list is empty.

STEP D - WRITE THREE STAKEHOLDER FIELDS
Write in formal, precise, professional English for a senior compliance audience.

1. "summary": One paragraph stating whether and how the vendor obligation is reflected in RegMap,
   naming the matched obligation ID(s) and citations, and characterising the overall alignment.

2. "missing_in_regmap": Each requirement stated in the VENDOR obligation that is absent from, or
   different in, the matched RegMap obligation(s). For EVERY item quote the vendor wording in double
   quotes and state what RegMap says (quoted) or that RegMap is silent. One item per line, starting with "- ".
   If nothing is missing write exactly: None identified.

3. "missing_in_vendor": Each requirement stated in the matched REGMAP obligation(s) that is absent from,
   or different in, the vendor obligation. For EVERY item quote the RegMap wording in double quotes,
   name the RegMap obligation ID, and state what the vendor says (quoted) or that the vendor is silent.
   One item per line, starting with "- ". If nothing is missing write exactly: None identified.

RULES FOR THE THREE FIELDS
- NEVER mention points, scores, deductions, codes, percentages, or HIGH/MEDIUM/LOW.
- NEVER give recommendations, actions, next steps or suggestions. Describe the facts only.
- Every gap must be supported by text in "double quotes" copied from the source.
- Be specific and complete; avoid repetition and filler.

STRICT RULES
- Only use Obligation IDs from the list below. Never invent IDs.
- If no RegMap obligation addresses the same requirement, return an empty matches list; in "summary"
  state that no corresponding RegMap obligation was identified; in "missing_in_regmap" list the vendor
  requirements with quotes; set "missing_in_vendor" to: None identified.

VENDOR OBLIGATION
Citation: {v['vendor_citation']}
Topic: {v['obligationdetails_topic']}
Summary: {v['obligationdetails_obligationsummary']}

REGMAP OBLIGATIONS
{regmap_block}

Return ONLY valid JSON (no markdown) in exactly this shape:
{{
  "vendor_elements": ["Obligated party: ...", "Action: ...", "Condition: ...", "Timing: ..."],
  "matches": [
    {{
      "obligation_id": "ROB-...",
      "deductions": [
        {{"code": "TIMING_MISSING", "evidence": "vendor: 'within 30 days'; RegMap: no deadline stated"}}
      ]
    }}
  ],
  "summary": "...",
  "missing_in_regmap": "- Vendor requires \\"...\\"; RegMap ROB-... is silent on this.\\n- ...",
  "missing_in_vendor": "- ROB-... requires \\"...\\"; the vendor obligation does not address this.\\n- ..."
}}"""

print(build_prompt(vd.iloc[0])[:3500])   # preview the instructions
