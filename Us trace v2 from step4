def clean_narrative(text):
    """Strip scoring language but KEEP line breaks (so '- ' bullets stay on separate lines)."""
    if not isinstance(text, str):
        return ""
    t = re.sub(r"\(?\s*[-+]?\d+\s*(points?|pts)\s*\)?", "", text, flags=re.I)  # "-10 points"
    t = re.sub(r"\b(" + "|".join(RUBRIC.keys()) + r")\b", "", t)                # internal codes
    t = re.sub(r"\b(score[ds]?|deduct(ed|ion|ions)?)\b", "", t, flags=re.I)     # scoring words
    t = re.sub(r"[ \t]{2,}", " ", t)                                             # collapse spaces only, not newlines
    return "\n".join(line.strip() for line in t.splitlines()).strip()




