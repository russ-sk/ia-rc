def norm_keys(df, cols):
    out = df.copy()
    for c in cols:
        out[c] = out[c].astype(str).str.strip()
        out.loc[out[c].isin(["nan", "None", "NaT", ""]), c] = np.nan
    return out

def keyed_merge(left, right, keys, label):
    missing = [k for k in keys if k not in left.columns or k not in right.columns]
    if missing:
        raise KeyError(f"{label}: missing join cols {missing}")
    l, r = norm_keys(left, keys), norm_keys(right, keys)
    merged = l.merge(r, on=keys, how="inner")
    rk = [k for k in ["REG_ID", "SUM_ID"] if k in l.columns]
    hit_full = len(l.merge(r[keys].drop_duplicates(), on=keys, how="inner"))
    hit_red  = len(l.merge(r[rk].drop_duplicates(), on=rk, how="inner"))
    print(f"\n[{label}] keys={len(keys)}  left={len(l):,} right={len(r):,} merged={len(merged):,}")
    print(f"    left rows matching on FULL key : {hit_full:,}")
    print(f"    left rows matching on {rk} : {hit_red:,}")
    if hit_red > hit_full:
        print(f"    [!] {hit_red - hit_full:,} rows match on IDs but not the full key "
              "— status/version strings differ between extracts")
    return merged

