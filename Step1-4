import re, numpy as np, pandas as pd
from pathlib import Path

REGMAP_DIR = Path(DATA) / "REGMAP"

def _k(s):
    return re.sub(r"[^a-z0-9]", "", str(s).lower())

def resolve(df, label, required=True):
    ex = [c for c in df.columns if _k(c) == _k(label)]
    if ex:
        return ex[0]
    lo = [c for c in df.columns if _k(label) in _k(c)]
    if len(lo) == 1:
        return lo[0]
    if required:
        raise KeyError(f"{label!r} -> candidates {lo or 'none'}\navailable: {list(df.columns)}")
    return None

def read_extract(n):
    hits = [p for p in REGMAP_DIR.iterdir()
            if p.suffix.lower() in {".xlsx", ".xls", ".csv", ".parquet"}
            and re.search(rf"extract\s*_?{n}\b", p.name, flags=re.I)]
    if not hits:
        raise FileNotFoundError(f"no Extract {n} in {REGMAP_DIR}: "
                                f"{[p.name for p in REGMAP_DIR.iterdir()]}")
    p = hits[0]
    if p.suffix.lower() == ".parquet":
        df = pd.read_parquet(p)
    elif p.suffix.lower() == ".csv":
        df = pd.read_csv(p, dtype=str)
    else:
        df = pd.read_excel(p, dtype=str)
    df.columns = [str(c).strip() for c in df.columns]
    print(f"[{p.name}] rows={len(df):,} cols={len(df.columns)}")
    return df

