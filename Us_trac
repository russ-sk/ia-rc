# Build one text entry per RegMap obligation, like:
#   [ROB-00024947] Citation: 1026.6(a)
#   Title: Account Opening Disclosures: Open-End Credit...
#   Text: The creditor must provide specific disclosures...
entries = []
for _, r in rm.iterrows():                  # loop over every RegMap obligation
    entry = (
        f"[{r['Obligation ID']}] Citation: {r['Obligation Citation']}\n"
        f"Title: {r['Obligation Title']}\n"
        f"Text: {r['Obligation Detailed Text']}"
    )
    entries.append(entry)

# Join all entries with a blank line between them
regmap_block = "\n\n".join(entries)

# The set of real IDs. Used in Step 5 to reject made-up IDs.
