EVAL_RECORDS = sorted({str(r) for r in KEEP_RECORDS} & set(gold.RECORD_ID))
print(f"scoring {len(EVAL_RECORDS)} records: {EVAL_RECORDS}")

absent = {str(r) for r in KEEP_RECORDS} - set(gold.RECORD_ID)
if absent:
    print(f"[!] not in golden, cannot be scored: {sorted(absent)}")

gold_e = gold[gold.RECORD_ID.isin(EVAL_RECORDS)]
pred_e = pred[pred.RECORD_ID.isin(EVAL_RECORDS)]



rows = []
for name, col in LEVELS:
    m = prf(pairs(pred_e, col), pairs(gold_e, col)); m["level"] = name; m["scope"] = "3 records"
