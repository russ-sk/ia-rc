    if p.suffix.lower() == ".parquet":
        import pyarrow.parquet as pq
        avail = set(pq.ParquetFile(p).schema.names)
        cols  = [c for c in usecols if c in avail] if usecols else None
        df = pd.read_parquet(p, columns=cols)
    else:
        df = (pd.read_csv(p, dtype=str) if p.suffix.lower()==".csv"
              else pd.read_excel(p, dtype=str))
        if usecols:
            df = df[[c for c in usecols if c in df.columns]]
    df.columns = [str(c).strip() for c in df.columns]
    print(f"[load] {p.name}: rows={len(df):,} cols={len(df.columns)}")
    return df

