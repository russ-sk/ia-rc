         "Partial": PatternFill("solid", fgColor="FFE699"),    # amber
         "No Match": PatternFill("solid", fgColor="E8462A")}   # red

with pd.ExcelWriter(SQ_OUT, engine="openpyxl") as writer:
    export_df.to_excel(writer, sheet_name="Summary vs Requirement", index=False)
    ws = writer.sheets["Summary vs Requirement"]

    for col, w in zip("ABCDEFGHI", [32, 14, 25, 70, 60, 12, 10, 70, 50]):
        ws.column_dimensions[col].width = w

    wrap = Alignment(wrap_text=True, vertical="top")
    for cell in ws[1]:
        cell.fill, cell.font, cell.alignment = PatternFill("solid", fgColor="DDEBF7"), Font(bold=True), wrap

    for row, mt in zip(ws.iter_rows(min_row=2, max_row=ws.max_row), export_df["Match Type"]):
        for cell in row:
            cell.alignment = wrap
            if mt in fills:
                cell.fill = fills[mt]
    ws.freeze_panes = "A2"

