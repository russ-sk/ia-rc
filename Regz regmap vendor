rm = df_regz_rsm2.copy()

# Clean text columns: remove literal "\n" and real line breaks, collapse spaces
for col in ["Obligation Title", "Obligation Detailed Text", "Obligation Citation"]:
    rm[col] = (rm[col].astype(str)
                      .str.replace(r"\\n|\n", " ", regex=True)
                      .str.replace(r"\s+", " ", regex=True)
                      .str.strip())

# One row per Obligation ID; if an obligation has several citations, join them with " | "
rm = (rm.groupby("Obligation ID", as_index=False)
        .agg({"Obligation Title":         "first",
              "Obligation Detailed Text": "first",
              "Obligation Citation":      lambda s: " | ".join(sorted(set(s)))}))

print("RegMap rows:", len(df_regz_rsm2), "-> unique obligations:", len(rm))
rm.head(3)


