def parse_json(txt):
    """Strip ``` fences if present, then convert text -> dict."""
    txt = re.sub(r"^```(json)?", "", str(txt).strip())
    txt = re.sub(r"```$", "", txt)
    return json.loads(txt.strip())

ALLOWED_GAP_TYPES = ["Covered", "Structural", "Missing in Vendor", "Missing in RegMap"]  # also the display order


def compare_one(o, retries=3):
    """Assess vendor coverage for one RegMap obligation."""
    prompt = build_prompt(o)

    for attempt in range(retries):
        raw = ai_chat(prompt)                                    # your existing API function

        if str(raw).startswith("API Error"):                     # gateway error -> wait and retry
            print("   API error:", str(raw)[:150])
            time.sleep(3 * (attempt + 1))
            continue

        try:
            out = parse_json(raw)

            # 1) Covering IDs: real IDs only, no duplicates, ordered by vendor citation
            ids = [i for i in dict.fromkeys(out.get("covering_vendor_ids", [])) if i in VALID_VENDOR_IDS]
            out["covering_vendor_ids"] = sorted(ids, key=lambda i: VENDOR_CITATION.get(i, ""))

            # 2) Status consistent with IDs
            status = str(out.get("coverage_status", "")).strip().upper()
            if not ids:
                status = "NONE"
            elif status not in ("FULL", "PARTIAL"):
                status = "PARTIAL"
            out["coverage_status"] = status

            # 3) Gaps: keep well-formed items with a known type, sorted in display order
            gaps = [g for g in out.get("gaps", [])
                    if isinstance(g, dict) and g.get("type") in ALLOWED_GAP_TYPES and g.get("point")]
            out["gaps"] = sorted(gaps, key=lambda g: ALLOWED_GAP_TYPES.index(g["type"]))
            return out

        except Exception as e:
            print("   Bad JSON, retrying:", e)

    # All retries failed -> placeholder so the loop keeps going
    return {"covering_vendor_ids": [], "coverage_status": "ERROR", "nearest_thematic": "",
            "gaps": [{"type": "Missing in Vendor",
                      "point": "Automated assessment could not be completed; manual review required.",
                      "evidence": ""}]}


def format_coverage_text(ids, nearest=""):
    """'• <vendor id> - <exact vendor text>' per covering vendor obligation, one per line."""
    if not ids:
        return nearest or "No related vendor obligation identified."
    return "\n".join(f"• {i} - {VENDOR_SUMMARY[i]}" for i in ids)


def format_gaps(gaps):
    """'• <Type>: <point> Evidence: <quoted evidence>' per gap, one per line."""
    lines = []
    for g in gaps:
        line = f"• {g['type']}: {g['point'].strip()}"
        if g.get("evidence"):
            line += f" Evidence: {g['evidence'].strip()}"
        lines.append(line)
    return "\n".join(lines)


