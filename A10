print("\ncontrols per summary, by approach (E3):")
print(e3p.groupby(["SUM_APPROACH", "SUM_ID"]).L1_LIB_CTRL.nunique()
      .groupby("SUM_APPROACH").describe()[["count", "50%", "90%", "max"]].to_string())
print("\nrisks per summary, by approach (E3):")
print(e3p.groupby(["SUM_APPROACH", "SUM_ID"]).LIB_RISK_ID.nunique()
      .groupby("SUM_APPROACH").describe()[["count", "50%", "90%", "max"]].to_string())


# %% A10b. Routing
DIRECT_APPROACHES = {"Detailed", "Enhanced"}
UNKNOWN_APPROACH  = "judged"        # blank / unrecognised -> judge, never inherit
RECORD_FILTER     = None            # None = all alerts in `pairs`

def route(a):
    a = str(a).strip().title()
    if a in DIRECT_APPROACHES:  return "direct"
    if a == "Standard":         return "judged"
    return UNKNOWN_APPROACH

# summary core attributes, one row per SUM_ID, approach taken from E3
summaries = e2p[SUMMARY_KEY + ["SUM_TITLE", "SUM_TEXT", "SUM_STEWARD"]].drop_duplicates()
assert summaries.SUM_ID.is_unique, "SUM_ID not unique — inspect before routing"

appr_e3 = e3p[["SUM_ID", "SUM_APPROACH"]].drop_duplicates("SUM_ID")
appr_e2 = e2p[["SUM_ID", "SUM_APPROACH"]].drop_duplicates("SUM_ID")
summaries = (summaries.merge(appr_e3, on="SUM_ID", how="left")
                      .merge(appr_e2, on="SUM_ID", how="left", suffixes=("", "_e2")))
summaries["SUM_APPROACH"] = summaries.SUM_APPROACH.fillna(summaries.SUM_APPROACH_e2)
summaries = summaries.drop(columns=["SUM_APPROACH_e2"])

# all LINKED alert-regulation pairs, not just the working three
linked_all = pairs.loc[pairs.decision == "LINKED",
                       ["RECORD_ID", "REG_ID", "link_score"]].copy()
linked_all["RECORD_ID"] = linked_all.RECORD_ID.astype(str).str.strip()
linked_all["REG_ID"]    = linked_all.REG_ID.astype(str).str.strip()
if RECORD_FILTER is not None:
    linked_all = linked_all[linked_all.RECORD_ID.isin({str(r) for r in RECORD_FILTER})]

alerts_all = load_alerts(set(linked_all.RECORD_ID))     # from RGL_Linkage_V1

a_sum = linked_all.merge(summaries, on="REG_ID", how="left")
orph = a_sum.loc[a_sum.SUM_ID.isna(), "REG_ID"].nunique()
if orph: print(f"[route] {orph} linked regulations have no published summary")
a_sum = a_sum.dropna(subset=["SUM_ID"])
a_sum["branch"] = a_sum.SUM_APPROACH.map(route)
a_sum = a_sum.merge(alerts_all[["RECORD_ID", "alert_text"]], on="RECORD_ID", how="left")

print(f"alerts={a_sum.RECORD_ID.nunique():,}  alert-summary rows={len(a_sum):,}")
print(f"rows by branch: {a_sum.branch.value_counts().to_dict()}")
print(f"approach in scope: {a_sum.SUM_APPROACH.value_counts(dropna=False).to_dict()}")
per = a_sum.groupby("RECORD_ID").branch.nunique()
print(f"alerts routing BOTH ways: {(per > 1).sum():,} of {len(per):,}")
print(f"alerts entirely direct  : {(a_sum.groupby('RECORD_ID').branch.agg(lambda s: set(s) == {'direct'})).sum():,}")


