        print(f"   risks : {str(r.via_risks)[:90]}")
        print(f"   via   : {r.via_regulations}   ({r.via_approaches})")
        print(f"   {str(r.control_description)[:200]}")

final.to_parquet(OUT / "laneA_control_recommendations.parquet", index=False)
a_sum.to_parquet(OUT / "laneA_routing.parquet", index=False)
if len(verdicts):
    verdicts.to_parquet(OUT / "laneA_risk_verdicts.parquet", index=False)
print(f"\nsaved -> {OUT/'laneA_control_recommendations.parquet'}")


