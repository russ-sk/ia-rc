# %% A10d. Judged branch — candidates and shortlist
LANE_A_HP = {"top_k": 15, "max_tokens": 6000, "concurrency": 10,
             "max_retries": 3, "min_score": 5}

hrisk_raw = read_helios("risk")
hrisks = (hrisk_raw[["library_risk_id", "library_risk_title",
                     "library_risk_description", "risk_status"]]
          .dropna(subset=["library_risk_id"])
          .drop_duplicates(subset=["library_risk_id"])
          .rename(columns={"library_risk_id": "LIB_RISK_ID",
                           "library_risk_title": "risk_title",
                           "library_risk_description": "risk_description"}))
hrisks["LIB_RISK_ID"] = hrisks.LIB_RISK_ID.astype(str).str.strip()
hrisks["risk_text"] = (hrisks.risk_title.fillna("") + ". " +
                       hrisks.risk_description.fillna("")).map(clean)
print(f"helios library risks with text: {len(hrisks):,}  "
      f"median len={hrisks.risk_text.str.len().median():.0f}")

j_sum = a_sum[a_sum.branch == "judged"]
cand = (j_sum[["RECORD_ID","REG_ID","SUM_ID","SUM_APPROACH","link_score","alert_text"]]
        .merge(rc[["REG_ID","SUM_ID","LIB_RISK_ID"]].drop_duplicates(),
               on=["REG_ID","SUM_ID"], how="inner"))
print(f"\njudged candidates: {len(cand):,} rows, "
      f"{cand.LIB_RISK_ID.nunique():,} distinct risks, "
      f"{cand.RECORD_ID.nunique():,} alerts")

need    = sorted(set(cand.LIB_RISK_ID) & set(hrisks.LIB_RISK_ID))
missing = sorted(set(cand.LIB_RISK_ID) - set(hrisks.LIB_RISK_ID))
if missing:
    print(f"[!] {len(missing)} candidate risks have no Helios text: {missing[:5]}")

rtext = hrisks.set_index("LIB_RISK_ID").risk_text.to_dict()
risk_vecs = embed_cache(need, [rtext[i] for i in need], "helios_library_risks")
rpos = {i: n for n, i in enumerate(need)}

a_ids  = sorted(cand.RECORD_ID.unique())
atext  = cand.drop_duplicates("RECORD_ID").set_index("RECORD_ID").alert_text.to_dict()
a_vecs = embed_cache(a_ids, [atext[i] for i in a_ids], "alerts")   # reuses stage-1 cache
apos   = {i: n for n, i in enumerate(a_ids)}

per_alert, cos = {}, {}
for rid in a_ids:
    pool = [c for c in cand.loc[cand.RECORD_ID == rid, "LIB_RISK_ID"].unique() if c in rpos]
    if not pool: continue
    idx   = [rpos[c] for c in pool]
    sims  = risk_vecs[idx] @ a_vecs[apos[rid]]
    order = np.argsort(-sims)[:LANE_A_HP["top_k"]]
    per_alert[rid] = [pool[i] for i in order]
    for i in order:
        cos[(rid, pool[i])] = float(sims[i])

pool_sz = pd.Series({r: cand.loc[cand.RECORD_ID == r, "LIB_RISK_ID"].nunique() for r in per_alert})
short_sz = pd.Series({k: len(v) for k, v in per_alert.items()})
print(f"\ncandidate pool per alert : median={pool_sz.median():.0f} max={pool_sz.max()}")
print(f"shortlist per alert      : median={short_sz.median():.0f} max={short_sz.max()}")
print(f"alerts where top_k bites : {(pool_sz > LANE_A_HP['top_k']).sum():,} of {len(pool_sz):,}")

spread = [max(cos[(r,c)] for c in per_alert[r]) - min(cos[(r,c)] for c in per_alert[r])
          for r in per_alert if len(per_alert[r]) > 1]
print(f"cosine spread within shortlist: median={np.median(spread):.3f}")


