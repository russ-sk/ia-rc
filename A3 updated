# %% A13. Precision / recall — flat, per record, three levels ------------------
RECORDS = sorted({str(r) for r in (KEEP_RECORDS or gold.RECORD_ID.unique())}
                 & set(gold.RECORD_ID))
print(f"scoring {len(RECORDS)} records: {RECORDS}")
absent = {str(r) for r in (KEEP_RECORDS or [])} - set(gold.RECORD_ID)
if absent:
    print(f"[!] not in golden, unscorable: {sorted(absent)}")

pred = laneA_exploded.copy()
pred["RECORD_ID"] = pred.RECORD_ID.astype(str).str.strip()

# (label, column in gold, column in Lane A output)
LEVELS = [("library_risk",        "LIB_RISK_ID",  "LIB_RISK_ID"),
          ("l1_library_control",  "L1_LIB_CTRL",  "L1_LIB_CTRL"),
          ("l1_control_instance", "L1_CTRL",      "l1_control_id")]


def sets_for(df, rid, col):
    if col not in df.columns:
        return set()
    s = df.loc[df.RECORD_ID.astype(str).str.strip() == rid, col]
    return {x for x in s.dropna().astype(str).str.strip() if x.lower() not in PLACEHOLDER}


def score(p, g):
    tp, fp, fn = len(p & g), len(p - g), len(g - p)
    pr  = tp / (tp + fp) if (tp + fp) else np.nan
    rc_ = tp / (tp + fn) if (tp + fn) else np.nan
    f1  = 2 * pr * rc_ / (pr + rc_) if (pr and rc_ and pr + rc_) else np.nan
    jac = tp / (tp + fp + fn) if (tp + fp + fn) else np.nan
    return tp, fp, fn, pr, rc_, f1, jac


rows = []
for level, gcol, pcol in LEVELS:
    ap, ag = set(), set()
    for rid in RECORDS:
        g, p = sets_for(gold, rid, gcol), sets_for(pred, rid, pcol)
        ag |= {(rid, x) for x in g}
        ap |= {(rid, x) for x in p}
        tp, fp, fn, pr, rc_, f1, jac = score(p, g)
        rows.append(dict(RECORD_ID=rid, level=level, n_gold=len(g), n_laneA=len(p),
                         matched=tp, extra_fp=fp, missed_fn=fn,
                         precision=pr, recall=rc_, f1=f1, jaccard=jac))
    tp, fp, fn, pr, rc_, f1, jac = score(ap, ag)
    rows.append(dict(RECORD_ID="ALL", level=level, n_gold=len(ag), n_laneA=len(ap),
                     matched=tp, extra_fp=fp, missed_fn=fn,
                     precision=pr, recall=rc_, f1=f1, jaccard=jac))

