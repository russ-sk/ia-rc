CITE_LABEL = {"COVERED": "Covered", "PARTIALLY COVERED": "Partially covered", "NOT COVERED": "Not covered"}


def format_coverage_text(ids, nearest=""):
    """'• <vendor id> - <exact vendor text>' per covering vendor obligation."""
    if not ids:
        return nearest or "No related vendor obligation identified."
    return "\n".join(f"• {i} - {VENDOR_SUMMARY.get(i, '')}" for i in ids)


def format_citation_coverage(cov):
    """'• 229.57 - Not covered. Evidence: ...' per RegMap citation (used in the test print)."""
    if not cov:
        return "No citation provided in RegMap."
    lines = []
    for c in cov:
        line = f"• {c['regmap_citation']} - {CITE_LABEL.get(c['status'], c['status'])}"
        if c["covering_vendor_ids"]:
            line += " by " + ", ".join(f"{i} ({VENDOR_CITATION.get(i, '')})" for i in c["covering_vendor_ids"])
        line += "."
        if c.get("evidence"):
            line += f" Evidence: {c['evidence'].strip()}"
        lines.append(line)
    return "\n".join(lines)


def format_gaps(gaps):
    """'• <Type>: <point> Evidence: <quoted evidence>' per gap."""
    out = []
    for g in gaps:
        line = f"• {g['type']}: {g['point'].strip()}"
        if g.get("evidence"):
            line += f" Evidence: {g['evidence'].strip()}"
        out.append(line)
    return "\n".join(out)

