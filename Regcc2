import re

def extract_citations(text):
    """
    Pull every citation out of a citation string, in order, no duplicates.
      '12 CFR 229.13 12 CFR 229.19(e)' -> ['229.13', '229.19(e)']
      '12 CFR 229.57 Sec. 1086(e)'     -> ['229.57', 'Sec. 1086(e)']
    cfr = section with a dot (229.19(e)); sec = statutory section written 'Sec.'/'Section'/'§' (Sec. 1086(e))
    """
    t = str(text)
    t = re.sub(r"\b\d+\s*CFR\b", " ", t, flags=re.I)          # drop "12 CFR"
    t = re.sub(r"\s+(?=\()", "", t)                            # "1086 (e)" -> "1086(e)"
    pattern = (r"(?P<cfr>\d{3,4}\.\d+[a-z]?(?:\([A-Za-z0-9]+\))*)"
               r"|(?:Sec(?:tion)?\.?|§)\s*(?P<sec>\d+[a-z]?(?:\([A-Za-z0-9]+\))*)(?![\d.])")
    out = [m.group("cfr") if m.group("cfr") else f"Sec. {m.group('sec')}"
           for m in re.finditer(pattern, t, flags=re.I)]
    return list(dict.fromkeys(out))


def related(vendor_cite, regmap_cite):
    """Same citation branch: 229.19(e)(1) under 229.19(e), or 229.19 above 229.19(e)."""
    v, r = vendor_cite, regmap_cite
    return v == r or v.startswith(r + "(") or r.startswith(v + "(")


def citation_candidates(cites):
    """{RegMap citation: [vendor IDs whose citation sits on the same branch]}"""
    return {c: [vid for vid, vc in VENDOR_CITATION.items() if related(vc, c)] for c in cites}


