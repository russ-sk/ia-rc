def match_regmap_citation(entry, cites, taken):
    """
    Map one model entry to a RegMap citation:
      1) exact match, 2) same branch (229.14(a) -> 229.14), 3) citation mentioned in the entry text.
    'taken' = citations already matched, so each RegMap citation gets one entry.
    """
    raw = str(entry.get("regmap_citation") or entry.get("citation") or entry.get("regmap_cite") or "").strip()
    parsed = extract_citations(raw) or ([raw] if raw else [])
    free = [c for c in cites if c not in taken]

    for p in parsed:                               # 1) exact
        if p in free:
            return p
    for p in parsed:                               # 2) same branch
        for c in free:
            if related(p, c):
                return c
    blob = json.dumps(entry)                       # 3) mentioned anywhere in the entry
    for c in free:
        if c in blob:
            return c
    return None


def validate(out, cites):
    """Make the LLM answer consistent with the RegMap citations and the citation rule."""
    cands = citation_candidates(cites)                                              # vendor rows citing each provision
    out["_raw_citation_coverage"] = json.loads(json.dumps(out.get("citation_coverage", [])))  # audit copy
    top_ids = clean_ids(out.get("covering_vendor_ids", []))                         # model's overall vendor picks

    # --- 1. Match each model entry to a RegMap citation ---
    given = {}
    for entry in out.get("citation_coverage", []) or []:
        if not isinstance(entry, dict):
            continue
        key = match_regmap_citation(entry, cites, taken=given.keys())
        if key is None:
            continue
        status = str(entry.get("status", "")).strip().upper()
        given[key] = {"regmap_citation": key,
                      "status": status if status in CITE_STATUSES else "PARTIALLY COVERED",
                      "covering_vendor_ids": clean_ids(entry.get("covering_vendor_ids")),
                      "evidence": str(entry.get("evidence", "")).strip()}

    coverage, citation_gaps = [], []
    for c in cites:
        e = given.get(c, {"regmap_citation": c, "status": "NOT COVERED", "covering_vendor_ids": [],
                          "evidence": "This citation was not assessed in the automated comparison; manual review required."})
        top_on_branch = [i for i in top_ids if i in cands[c]]   # overall picks that cite this provision

        # (a) Covered but no per-citation IDs -> backfill from overall picks on this branch
        if e["status"] != "NOT COVERED" and not e["covering_vendor_ids"]:
            e["covering_vendor_ids"] = top_on_branch

        # (b) Not covered / not assessed, but overall picks cite this provision -> partially covered
        if e["status"] == "NOT COVERED" and top_on_branch:
            e["status"] = "PARTIALLY COVERED"
            e["covering_vendor_ids"] = top_on_branch
            ids_txt = ", ".join(f"{i} ({VENDOR_CITATION[i]})" for i in top_on_branch)
            prior = "" if e["evidence"].startswith("This citation was not assessed") else e["evidence"]
            e["evidence"] = (f"Vendor obligations citing this provision were identified ({ids_txt}); "
                             f"content coverage requires confirmation. {prior}").strip()

        # (c) Covered with no vendor IDs at all -> not credible
        if e["status"] != "NOT COVERED" and not e["covering_vendor_ids"]:
            e["status"] = "NOT COVERED"

        # (d) Citation rule: no vendor obligation cites this provision -> Not covered
        if STRICT_CITATION and not cands[c]:
            if e["covering_vendor_ids"]:
                related_ids = ", ".join(f"{i} ({VENDOR_CITATION[i]})" for i in e["covering_vendor_ids"])
                e["evidence"] = (f"No vendor obligation cites {c}. Related content appears in vendor obligations "
                                 f"under other citations ({related_ids}), but the provision itself is not identified "
                                 f"by the vendor. {e['evidence']}").strip()
            elif not e["evidence"].startswith("No vendor obligation cites"):
                e["evidence"] = f"No vendor obligation cites {c}. {e['evidence']}".strip()
            e["status"] = "NOT COVERED"
            e["covering_vendor_ids"] = []

        # Every uncovered citation becomes a gap bullet
        if e["status"] != "COVERED":
            citation_gaps.append({"citation": c, "type": "Missing in Vendor",
                                  "point": f"Citation {c} is {CITE_LABEL[e['status']].lower()} by the vendor obligations.",
                                  "evidence": e["evidence"]})
        coverage.append(e)
    out["citation_coverage"] = coverage

    # --- 2. Overall vendor IDs ---
    out["covering_vendor_ids"] = clean_ids(top_ids + [i for e in coverage for i in e["covering_vendor_ids"]])

    # --- 3. Overall status ---
    status = str(out.get("coverage_status", "")).strip().upper()
    if not out["covering_vendor_ids"]:
        status = "NONE"
    elif any(e["status"] != "COVERED" for e in coverage):
        status = "PARTIAL"                                  # cannot be FULL with an uncovered citation
    elif status not in ("FULL", "PARTIAL"):
        status = "PARTIAL"
    out["coverage_status"] = status

    # --- 4. Gaps: model's gaps + uncovered citations it didn't mention ---
    gaps = [g for g in out.get("gaps", [])
            if isinstance(g, dict) and g.get("type") in ALLOWED_GAP_TYPES and g.get("point")]
    mentioned = " ".join(str(g.get("point", "")) + " " + str(g.get("evidence", "")) for g in gaps)
    for g in citation_gaps:
        if g["citation"] not in mentioned:
            gaps.append({k: g[k] for k in ("type", "point", "evidence")})
    out["gaps"] = sorted(gaps, key=lambda g: ALLOWED_GAP_TYPES.index(g["type"]))
    return out

