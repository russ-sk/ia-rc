from openpyxl.styles import PatternFill, Font, Alignment

OUT_FILE = "RegCC - Analytics Results.xlsx"

HEADER_FILL = PatternFill("solid", fgColor="DDEBF7")   # light blue header
RED_FILL    = PatternFill("solid", fgColor="E8462A")   # missing
AMBER_FILL  = PatternFill("solid", fgColor="FFE699")   # partial
WRAP_TOP    = Alignment(wrap_text=True, vertical="top")


def write_sheet(writer, df, sheet, widths, fills):
    """Write df (minus '_status') with column widths, header style, wrapped text and row colours."""
    df.drop(columns=["_status"]).to_excel(writer, sheet_name=sheet, index=False)
    ws = writer.sheets[sheet]
    for i, w in enumerate(widths):
        ws.column_dimensions[chr(65 + i)].width = w
    for cell in ws[1]:
        cell.fill, cell.font, cell.alignment = HEADER_FILL, Font(bold=True), WRAP_TOP
    for row, fill in zip(ws.iter_rows(min_row=2, max_row=ws.max_row), fills):
        for cell in row:
            cell.alignment = WRAP_TOP
            if fill:
                cell.fill = fill
    ws.freeze_panes = "A2"


# ROB level: red = no vendor coverage, amber = at least one missing citation
rob_fills = [RED_FILL if s == "None" else (AMBER_FILL if m != "None" else None)
             for s, m in zip(rob_level_df["_status"], rob_level_df["Missing Citation(s)"])]

# Citation level: red = not covered, amber = partially covered
cite_fills = [{"NOT COVERED": RED_FILL, "PARTIALLY COVERED": AMBER_FILL}.get(s)
              for s in citation_level_df["_status"]]

with pd.ExcelWriter(OUT_FILE, engine="openpyxl") as writer:
    write_sheet(writer, rob_level_df, "ROB Level",
                widths=[18, 60, 22, 35, 70, 28, 75], fills=rob_fills)
    write_sheet(writer, citation_level_df, "ROB x Citation Level",
                widths=[18, 60, 16, 35, 70, 75], fills=cite_fills)

print("Saved:", OUT_FILE, "| sheets: ROB Level, ROB x Citation Level")







