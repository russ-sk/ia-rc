from openpyxl.styles import PatternFill, Font, Alignment

HEADER_FILL = PatternFill("solid", fgColor="DDEBF7")   # light blue
RED_FILL    = PatternFill("solid", fgColor="E8462A")   # missing
AMBER_FILL  = PatternFill("solid", fgColor="FFE699")   # partial
WRAP_TOP    = Alignment(wrap_text=True, vertical="top")


def write_sheet(writer, df, sheet, widths, fills):
    """
    df     : table to export (helper column '_status' is dropped)
    widths : column widths in order
    fills  : list with one fill (or None) per data row
    """
    df.drop(columns=["_status"]).to_excel(writer, sheet_name=sheet, index=False)
    ws = writer.sheets[sheet]

    for i, w in enumerate(widths):                     # column widths
        ws.column_dimensions[chr(65 + i)].width = w

    for cell in ws[1]:                                 # header row
        cell.fill, cell.font, cell.alignment = HEADER_FILL, Font(bold=True), WRAP_TOP

    for row, fill in zip(ws.iter_rows(min_row=2, max_row=ws.max_row), fills):
        for cell in row:
            cell.alignment = WRAP_TOP                  # wrap so bullets show on separate lines
            if fill:
                cell.fill = fill

    ws.freeze_panes = "A2"


